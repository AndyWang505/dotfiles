# Everything the stow packages in this repo assume is on PATH.
# Install with: brew bundle

brew "git"
brew "gh"
brew "stow"

# Shells
brew "fish"

# Terminal multiplexer (plugins are managed by TPM, see install.sh)
brew "tmux"

# Editor and the tools its pickers shell out to
brew "neovim"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "lazygit"

# Node toolchain
brew "nvm"
brew "pnpm"

# PHP dependency manager; .zshrc puts ~/.composer/vendor/bin on PATH
brew "composer"

cask "ghostty"
cask "font-jetbrains-mono-nerd-font"
