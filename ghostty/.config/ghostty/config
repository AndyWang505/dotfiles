# Gets fish without chsh'ing the login shell, so scripts and anything reading
# /etc/passwd keep getting zsh
command = /opt/homebrew/bin/fish

theme = TokyoNight Night

font-family = JetBrainsMono Nerd Font
font-size = 14

background-opacity = 0.85
background-blur-radius = 20

# ssh-terminfo installs xterm-ghostty on the remote host, so TERM does not have
# to be downgraded to xterm-256color to keep ssh usable
shell-integration-features = ssh-env,ssh-terminfo
