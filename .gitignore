.DS_Store
*.swp
*.swo
**/.claude/

# stow folds a package's directory into a single symlink, so anything a plugin
# manager writes under it lands inside this repo.
tmux/.config/tmux/plugins/
fish/.config/fish/completions/
fish/.config/fish/functions/
fish/.config/fish/themes/
fish/.config/fish/conf.d/_tide_init.fish
fish/.config/fish/conf.d/nvm.fish
fish/.config/fish/fish_variables*
fish/.config/fish/config-local.fish

# Config that only makes sense inside one employer's repos. init.lua stays, so
# `{ import = "plugins.local" }` still finds a module on a machine with none.
nvim/.config/nvim/lua/config/local.lua
nvim/.config/nvim/lua/plugins/local/*
!nvim/.config/nvim/lua/plugins/local/init.lua
